# LLM endpoint (optional — configure in Settings UI instead)
LLM_ENDPOINT=https://your-resource.openai.azure.com/

# LLM API key (optional — configure in Settings UI instead)
LLM_API_KEY=your-api-key-here

# LLM model name or Azure deployment name (optional, default: gpt-5.6-luna)
LLM_MODEL=gpt-5.6-luna

# Feed polling interval in minutes (optional, default: 30)
POLL_INTERVAL_MINUTES=30

# Language for generated summaries (optional, default: English)
SUMMARY_LANGUAGE=English
