# Azure OpenAI endpoint (optional — configure in Settings UI instead)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure OpenAI API key (optional — configure in Settings UI instead)
AZURE_OPENAI_KEY=your-api-key-here

# Azure OpenAI model deployment name (optional, default: gpt-4.1)
AZURE_OPENAI_MODEL=gpt-4.1

# Feed polling interval in minutes (optional, default: 30)
POLL_INTERVAL_MINUTES=30

# Language for generated summaries (optional, default: English)
SUMMARY_LANGUAGE=English
